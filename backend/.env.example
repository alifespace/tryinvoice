# 数据库连接；按部署环境注入，不要提交真实凭证。
DATABASE_URL=

# Supabase 身份验证配置。
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWKS_CACHE_SECONDS=600
SUPABASE_JWKS_TIMEOUT_SECONDS=3.0
# 仅在迁移旧 HS256 签名时显式启用；默认只接受 ES256/JWKS。
SUPABASE_ALLOW_LEGACY_HS256=false

# 应用运行模式；生产环境请使用 production。
APP_ENV=local
# 本地开发身份：启用时填写有效 UUID；未启用或生产环境删除/注释此项，不得留空。
LOCAL_DEV_USER_ID=

# 对象存储配置。
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_PRESIGN_TTL_SECONDS=900
